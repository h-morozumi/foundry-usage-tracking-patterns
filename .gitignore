# =============================================================================
# Azure Developer CLI (azd)
# =============================================================================
# 各パターンディレクトリ配下に作られる azd 環境状態（シークレットを含む可能性あり）
.azure/

# azd packaging output
**/dist/

# =============================================================================
# Bicep
# =============================================================================
# infra/ 配下の .bicep からビルドされた ARM テンプレート（コミット不要）
infra/**/*.json.bak
# bicep build の一時出力（main.bicep と同名の main.json は通常不要）
**/main.json

# =============================================================================
# Python (uv)
# =============================================================================
# 仮想環境
.venv/
venv/
ENV/
env/

# uv キャッシュ / ローカルツール
.uv-cache/

# バイトコード
__pycache__/
*.py[cod]
*$py.class
*.so

# パッケージング
*.egg-info/
*.egg
build/
dist/
wheels/
*.whl

# テスト・カバレッジ
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# 型チェッカー
.mypy_cache/
.pyright/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# =============================================================================
# 環境変数・シークレット
# =============================================================================
# 機微情報は絶対にコミットしない（サンプルは .env.sample / .env.example を残す）
.env
.env.*
!.env.sample
!.env.example
!.env.template

# トークンキャッシュ
.msal_cache
.msal_token_cache.bin

# =============================================================================
# IDE / エディタ
# =============================================================================
# VS Code はワークスペース共通設定（settings.json, extensions.json）を共有したい場合があるため、
# ユーザー固有のファイルだけ無視する方針
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/
*.iml

# Visual Studio
.vs/

# =============================================================================
# OS
# =============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.Trash-*

# =============================================================================
# ログ・一時ファイル
# =============================================================================
*.log
logs/
*.tmp
*.swp
*.swo

# =============================================================================
# Node (補助スクリプト用)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
