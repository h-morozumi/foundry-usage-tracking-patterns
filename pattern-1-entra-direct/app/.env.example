# Pattern 1 (Entra Direct) サンプル用の環境変数テンプレート。
#
# 使い方:
#   1) このファイルを `.env` にコピー (`cp .env.example .env` / `Copy-Item .env.example .env`)
#   2) `azd env get-values > .env` で azd の出力をそのまま上書きしてもよい
#   3) `uv run chat.py "..."` で python-dotenv が自動ロードする
#
# `.env` は .gitignore 済み。シェルに既に変数が設定されていればそちらが優先される。

# ---- chat.py が必須とする値 ----

# AOAI アカウントのエンドポイント URL (末尾の `/` はあってもなくても可)
# 例: https://aoai-xxxxxxxxxxxx.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# AOAI 上にデプロイしたモデルのデプロイ名 (main.bicep の chatDeploymentName と一致)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ---- 参考: azd env get-values が併せて出力する値 ----
# AZURE_LOCATION=japaneast
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_RESOURCE_GROUP=rg-aoai-track-dev
# LOG_ANALYTICS_WORKSPACE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.OperationalInsights/workspaces/log-xxxxxxxxxxxx
# LOG_ANALYTICS_WORKSPACE_NAME=log-xxxxxxxxxxxx
